# Copy to .env.secrets in the project root. NEVER commit .env.secrets.
# Only the LocalStack container reads this file; it stores each key in LocalStack's
# Secrets Manager, and only the worker fetches them from there. The API and the
# Angular app never see these values.

# Google AI Studio key (free tier, no card). Synthetic documents only: free-tier
# inputs may be used by Google to improve its products (NFR-1.5).
GEMINI_API_KEY=

# NVIDIA build.nvidia.com key (nvapi-...). Synthetic documents only.
NVIDIA_API_KEY=

# Optional. Leave empty to catch all alert emails in Mailpit (http://localhost:8025).
BREVO_API_KEY=

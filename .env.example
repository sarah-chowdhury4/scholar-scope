# Copy to .env (docker compose reads it automatically). NEVER commit .env.
# Generate each random value with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# --- Images: tested digests, shared by the whole team (tested 2026-11-03) ---
# MinIO's own images are gone (Docker Hub deleted, quay.io private). Chainguard's free build of
# MinIO includes sh, wget and mc in the -dev variant, so it serves as both images. Pin the digest.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:6d4f84fa90a51955476b23d9bc3bc371d60835c59d1b36826169e0392c2b57a2
MC_IMAGE=cgr.dev/chainguard/minio@sha256:6d4f84fa90a51955476b23d9bc3bc371d60835c59d1b36826169e0392c2b57a2
LOCALSTACK_IMAGE=localstack/localstack@sha256:2290500d7398e6458544fab2f49aaf170b81a1006ee69067e8e7fc59b810a824
CLAMAV_IMAGE=clamav/clamav:stable
MAILPIT_IMAGE=axllent/mailpit:latest

# --- MinIO admin (used only by minio and minio-init) ---
MINIO_ROOT_USER=ss-root
MINIO_ROOT_PASSWORD=

# --- One MinIO user per service (least privilege, mirrors the GCP service accounts) ---
MINIO_API_ACCESS_KEY=ss-api
MINIO_API_SECRET_KEY=
MINIO_WORKER_ACCESS_KEY=ss-worker
MINIO_WORKER_SECRET_KEY=
MINIO_DELETER_ACCESS_KEY=ss-deleter
MINIO_DELETER_SECRET_KEY=

# --- LocalStack (free account token from app.localstack.cloud) ---
LOCALSTACK_AUTH_TOKEN=

# --- AI model id from Google AI Studio (e.g. the current Gemini Flash id) ---
GEMINI_MODEL=

# NVIDIA NIM for the light AI jobs (classify, embed). Set to false if you have no NVIDIA key:
# those jobs then run on Gemini. Keep one setting per environment (embedding sizes differ).
NIM_ENABLED=true
# Which AI reads requirements, checks documents, summarises changes and drafts essays:
#   gemini (default) | nim (NVIDIA only; needs NVIDIA_API_KEY) | auto (Gemini, and NIM whenever Gemini is busy or out of quota).
# Web search for official pages needs Gemini, so it is skipped with nim.
AI_PROVIDER=gemini
# Optional: other NVIDIA models (when one is retired it answers HTTP 410). Blank = the defaults in shared/src/platform/ai/nim.ts.
# NIM_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# NIM_JSON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Saved scholarship web pages are read with Jina Reader (jina.ai), falling back to a direct fetch.
# Set to direct to never send page addresses to Jina. Student uploads never go to Jina.
READER_BACKEND=jina

# Email. smtp = every email goes to the Mailpit test inbox (http://localhost:8025).
# gmail = real inboxes from a Gmail account: set SMTP_USER to the address and put its app password in
#         .env.secrets as SMTP_PASSWORD. Emails come from that address; MAIL_FROM only sets the display name.
# brevo = real inboxes through Brevo: BREVO_API_KEY in .env.secrets, MAIL_FROM = a sender verified in Brevo.
MAIL_BACKEND=smtp
MAIL_FROM=
SMTP_USER=

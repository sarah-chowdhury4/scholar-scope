# Copy to .env (docker compose reads it automatically). NEVER commit .env.
# Generate each random value with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# --- Images: tested digests, shared by the whole team (tested 2026-11-03) ---
# MinIO's own images are gone (Docker Hub deleted, quay.io private). Chainguard's free build of
# MinIO includes sh, wget and mc in the -dev variant, so it serves as both images. Pin the digest.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:6d4f84fa90a51955476b23d9bc3bc371d60835c59d1b36826169e0392c2b57a2
MC_IMAGE=cgr.dev/chainguard/minio@sha256:6d4f84fa90a51955476b23d9bc3bc371d60835c59d1b36826169e0392c2b57a2
LOCALSTACK_IMAGE=localstack/localstack@sha256:2290500d7398e6458544fab2f49aaf170b81a1006ee69067e8e7fc59b810a824
CLAMAV_IMAGE=clamav/clamav:stable
MAILPIT_IMAGE=axllent/mailpit:latest

# --- MinIO admin (used only by minio and minio-init) ---
MINIO_ROOT_USER=ss-root
MINIO_ROOT_PASSWORD=

# --- One MinIO user per service (least privilege, mirrors the GCP service accounts) ---
MINIO_API_ACCESS_KEY=ss-api
MINIO_API_SECRET_KEY=
MINIO_WORKER_ACCESS_KEY=ss-worker
MINIO_WORKER_SECRET_KEY=
MINIO_DELETER_ACCESS_KEY=ss-deleter
MINIO_DELETER_SECRET_KEY=

# --- LocalStack (free account token from app.localstack.cloud) ---
LOCALSTACK_AUTH_TOKEN=

# --- AI model id from Google AI Studio (e.g. the current Gemini Flash id) ---
GEMINI_MODEL=

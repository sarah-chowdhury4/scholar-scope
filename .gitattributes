# Shell scripts run inside Linux containers: keep LF line endings even on Windows
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Terraform files are checked by `terraform fmt -check` inside Linux containers: keep LF
*.tf text eol=lf
*.tfvars text eol=lf
*.tfvars.example text eol=lf
*.hcl text eol=lf
